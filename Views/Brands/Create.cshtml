
@model EarbudExplorer.Models.Brand

@{
    // Set the page title.
    ViewData["Title"] = "Create Brand";
}

<h1>Create Brand</h1>

<h4>Add a New Earbud Brand</h4>
<hr />

<div class="row">
    <div class="col-md-6">

        <!-- Submit the form to the POST Create action. -->
        <form asp-action="Create" method="post">

            <!-- Display validation errors from the controller. -->
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <!-- Label and input are connected to Brand.Name. -->
                <label asp-for="Name"
                       class="form-label"></label>

                <input asp-for="Name"
                       class="form-control" />

                <!-- Display errors when the name is invalid. -->
                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Create
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <!-- Load JavaScript validation for the form. -->
    <partial name="_ValidationScriptsPartial" />
}
