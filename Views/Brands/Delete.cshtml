
@model EarbudExplorer.Models.Brand

@{
    // Set the page title.
    ViewData["Title"] = "Delete Brand";
}

<h1>Delete Brand</h1>

<h4>Are you sure you want to delete this brand?</h4>

<!-- Warn the user before permanently deleting data. -->
<p class="text-danger">
    This action cannot be undone.
</p>

<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Brand Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
    </dl>

    <!-- Display errors if the brand has associated earbuds. -->
    <div asp-validation-summary="All"
         class="text-danger"></div>

    <!-- Send the brand ID to the POST Delete action. -->
    <form asp-action="Delete"
          asp-route-id="@Model.BrandId"
          method="post">

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">Cancel</a>
    </form>
</div>
