
@model EarbudExplorer.Models.Brand

@{
    // Set the page title.
    ViewData["Title"] = "Brand Details";
}

<h1>Brand Details</h1>

<!-- Display information about the selected brand. -->
<div>
    <h4>@Model.Name</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Brand ID
        </dt>
        <dd class="col-sm-10">
            @Model.BrandId
        </dd>

        <dt class="col-sm-2">
            Brand Name
        </dt>
        <dd class="col-sm-10">
            @Model.Name
        </dd>
    </dl>
</div>

<!-- Provide navigation back to the list or editing page. -->
<div>
    <a asp-action="Edit"
       asp-route-id="@Model.BrandId"
       class="btn btn-primary">Edit</a>

    <a asp-action="Index"
       class="btn btn-secondary">Back to List</a>
</div>
