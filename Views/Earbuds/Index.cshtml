
@{
    ViewData["Title"] = "Search Earbuds";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1>Explore Earbuds</h1>
        <p class="text-secondary">
            Find the perfect earbuds for your needs.
        </p>
    </div>

    <div class="row g-4">

        <!-- FILTERS -->
        <div class="col-lg-3">

            <div class="card p-3">

                <h4 class="mb-3">Filters</h4>

                <!-- Search -->
                <div class="mb-3">
                    <label for="searchInput"
                           class="form-label">
                        Search by name
                    </label>

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search earbuds..." />
                </div>

                <!-- Brand -->
                <div class="mb-3">
                    <label for="brandFilter"
                           class="form-label">
                        Brand
                    </label>

                    <select id="brandFilter"
                            class="form-select">
                        <option value="">All Brands</option>
                    </select>
                </div>

                <!-- Price -->
                <div class="mb-3">
                    <label class="form-label">
                        Price Range
                    </label>

                    <div class="row g-2">
                        <div class="col">
                            <input type="number"
                                   id="minPrice"
                                   class="form-control"
                                   placeholder="Min"
                                   min="0"
                                   step="0.01" />
                        </div>

                        <div class="col">
                            <input type="number"
                                   id="maxPrice"
                                   class="form-control"
                                   placeholder="Max"
                                   min="0"
                                   step="0.01" />
                        </div>
                    </div>
                </div>

                <!-- Features -->
                <div class="mb-3">
                    <label class="form-label">
                        Features
                    </label>

                    <div id="featureFilters">
                        <p class="text-secondary small">
                            Loading features...
                        </p>
                    </div>
                </div>

                <!-- Additional filters -->
                <div class="mb-3">

                    <label class="form-label">
                        Additional Options
                    </label>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="noiseCancellationFilter" />

                        <label class="form-check-label"
                               for="noiseCancellationFilter">
                            Noise Cancellation
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="transparencyFilter" />

                        <label class="form-check-label"
                               for="transparencyFilter">
                            Transparency Mode
                        </label>
                    </div>

                </div>

                <button id="clearFilters"
                        class="btn btn-outline-secondary w-100">
                    Clear Filters
                </button>

            </div>
        </div>

        <!-- SEARCH RESULTS -->
        <div class="col-lg-9">

            <div class="d-flex justify-content-between
                        align-items-center mb-3 flex-wrap gap-2">

                <h4 class="mb-0">Search Results</h4>

                <select id="sortFilter"
                        class="form-select"
                        style="width: 200px;">

                    <option value="name-asc">
                        Name (A-Z)
                    </option>

                    <option value="name-desc">
                        Name (Z-A)
                    </option>

                    <option value="price-asc">
                        Price (Low to High)
                    </option>

                    <option value="price-desc">
                        Price (High to Low)
                    </option>

                    <option value="rating-desc">
                        Highest Rated
                    </option>

                    <option value="battery-desc">
                        Best Battery Life
                    </option>

                </select>

            </div>

            <p id="resultCount"
               class="text-secondary">
                Loading earbuds...
            </p>

            <div id="earbudResults"
                 class="row g-4">

                <!-- JavaScript inserts products here -->

            </div>

            <div id="noResults"
                 class="text-center py-5"
                 style="display: none;">

                <h4>No Earbuds Found</h4>

                <p class="text-secondary">
                    Try changing your search or filters.
                </p>

            </div>

            <div id="loadingMessage"
                 class="text-center py-5">

                <div class="spinner-border"
                     role="status">
                    <span class="visually-hidden">
                        Loading...
                    </span>
                </div>

                <p class="mt-2">
                    Loading earbuds...
                </p>

            </div>

            <div id="errorMessage"
                 class="alert alert-danger"
                 style="display: none;">
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/earbuds.js"
            asp-append-version="true"
            defer>
    </script>
}
