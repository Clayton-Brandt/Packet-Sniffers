
@{
    ViewData["Title"] = "Earbud Explorer";
}

<div class="homepage-background">
    <div class="hero">

        <h1>Earbud Explorer</h1>

        <h2>Find the perfect earbuds for you.</h2>

        <p>
            Explore different brands, compare specifications,
            and discover earbuds that fit your needs.
        </p>

        <div class="hero-buttons">

            <a asp-controller="Earbuds"
               asp-action="Index"
               class="btn btn-primary btn-lg">
                Explore Earbuds
            </a>

        </div>

    </div>
</div>
